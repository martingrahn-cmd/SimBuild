      "evidence": "/Volumes/ExtDrive/SimBuild-verification-2026-09-06/transit/r2/critic/transit_night_stop_22.png; /Volumes/ExtDrive/SimBuild-verification-2026-09-06/transit/r2/critic/transit_stop_12.png; /Volumes/ExtDrive/SimBuild-verification-2026-09-06/transit/r2/critic/transit_closeup_12.png"
